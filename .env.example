# Values injected into the Android APK by Gradle. Never put a service_role key here.
TZINDA_SUPABASE_URL=https://your-project-id.supabase.co
TZINDA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
TZINDA_SUPABASE_REDIRECT_URL=com.guardian.tzindaapp.v2://auth-callback
# Optional: reads prescription photos with NVIDIA NIM. Without a key the scan stays on-device.
# The key is embedded in the APK, so use a dedicated key and rotate it if the APK is shared.
TZINDA_NVIDIA_API_KEY=
TZINDA_NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
