# Values injected into the Android APK by Gradle. Never put a service_role or NVIDIA API key here.
TZINDA_SUPABASE_URL=https://your-project-id.supabase.co
TZINDA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
TZINDA_SUPABASE_REDIRECT_URL=com.guardian.tzindaapp.v2://auth-callback
# Public OAuth client ID of the Web application in Google Auth Platform.
TZINDA_GOOGLE_WEB_CLIENT_ID=
# NVIDIA API keys and model configuration belong in Supabase Edge Function secrets only.
